<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_cogepart_form" model="ir.ui.view">
        <field name="name">delivery.carrier.cogepart.form</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cogepart" name="cogepart" invisible="delivery_type != 'cogepart'">
                    <group>
                        <group string="Connexion API Cogepart">
                            <field name="cogepart_login" required="delivery_type == 'cogepart'"/>
                            <field name="cogepart_password" password="True" required="delivery_type == 'cogepart'"/>
                            <field name="cogepart_api_url" required="delivery_type == 'cogepart'"/>
                        </group>
                        <group string="Adresse d'enlèvement (entrepôt)">
                            <field name="cogepart_pickup_name" required="delivery_type == 'cogepart'"/>
                            <field name="cogepart_pickup_phone" required="delivery_type == 'cogepart'"/>
                            <field name="cogepart_pickup_street" required="delivery_type == 'cogepart'"/>
                            <field name="cogepart_pickup_zip" required="delivery_type == 'cogepart'"/>
                            <field name="cogepart_pickup_city" required="delivery_type == 'cogepart'"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
